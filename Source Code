private func colorFromHex(_ hex: String) -> NSColor? {
    let value = hex.trimmingCharacters(in: .whitespacesAndNewlines)
    guard value.count == 7, value.first == "#",
          let rgb = UInt32(value.dropFirst(), radix: 16) else { return nil }
    return NSColor(
        red: CGFloat((rgb >> 16) & 0xFF) / 255,
        green: CGFloat((rgb >> 8) & 0xFF) / 255,
        blue: CGFloat(rgb & 0xFF) / 255,
        alpha: 1
    )
}

private func hexFromColor(_ color: NSColor) -> String {
    let rgb = color.usingColorSpace(.deviceRGB) ?? .black
    return String(
        format: "#%02X%02X%02X",
        Int((rgb.redComponent * 255).rounded()),
        Int((rgb.greenComponent * 255).rounded()),
        Int((rgb.blueComponent * 255).rounded())
    )
}

final class AppDelegate: NSObject, NSApplicationDelegate {
    private let blackout = BlackoutController()
    private var osc: OSCServer?
    private var statusItem: NSStatusItem!
    private var controls: ControlsWindowController!
    private var selectedOverlayColor = NSColor.black

    private let interfaceDefaultsKey = "oscInterface"
    private let mediaPathDefaultsKey = "overlayMediaPath"
    private let loopVideoDefaultsKey = "loopVideo"
    private let muteVideoDefaultsKey = "muteVideo"
    private var interfaces: [NetworkInterface] { NetworkInterface.available() }

    private var port: UInt16 {
        let value = UserDefaults.standard.integer(forKey: "oscPort")
        return UInt16(clamping: value == 0 ? 58573 : value)
    }

    private var selectedInterfaceName: String {
        get { UserDefaults.standard.string(forKey: interfaceDefaultsKey) ?? "any" }
        set { UserDefaults.standard.set(newValue, forKey: interfaceDefaultsKey) }
    }

    private var selectedInterface: NetworkInterface? {
        guard selectedInterfaceName != "any" else { return nil }
        return interfaces.first { $0.name == selectedInterfaceName }
    }

    private var savedMediaURL: URL? {
        guard let path = UserDefaults.standard.string(forKey: mediaPathDefaultsKey), !path.isEmpty else { return nil }
        return URL(fileURLWithPath: path)
    }

    private var loopVideo: Bool {
        get { UserDefaults.standard.bool(forKey: loopVideoDefaultsKey) }
        set { UserDefaults.standard.set(newValue, forKey: loopVideoDefaultsKey) }
    }

    private var muteVideo: Bool {
        get { UserDefaults.standard.bool(forKey: muteVideoDefaultsKey) }
        set { UserDefaults.standard.set(newValue, forKey: muteVideoDefaultsKey) }
    }

    func applicationDidFinishLaunching(_ notification: Notification) {
        if UserDefaults.standard.object(forKey: "oscPort") == nil {
            UserDefaults.standard.set(58573, forKey: "oscPort")
        }

        if selectedInterfaceName != "any" && selectedInterface == nil {
            selectedInterfaceName = "any"
        }

        blackout.mediaURL = savedMediaURL
        blackout.loopVideo = loopVideo
        blackout.muteVideo = muteVideo
        selectedOverlayColor = colorFromHex(
            UserDefaults.standard.string(forKey: "overlayColorHex") ?? "#000000"
        ) ?? .black

        NSApp.setActivationPolicy(.accessory)
        installMainMenu()
        installStatusMenu()

        controls = ControlsWindowController(
            initialPort: port,
            blackout: { [weak self] in self?.blackOut() },
            black: { [weak self] in self?.blackDisplays() },
            restore: { [weak self] in self?.restore() },
            toggle: { [weak self] in self?.toggle() },
            chooseMedia: { [weak self] in self?.chooseMedia() },
            clearMedia: { [weak self] in self?.clearMedia() },
            initialLoopVideo: loopVideo,
            changeLoopVideo: { [weak self] in self?.setLoopVideo($0) },
            initialMuteVideo: muteVideo,
            changeMuteVideo: { [weak self] in self?.setMuteVideo($0) },
            changePort: { [weak self] in self?.setPort($0) },
            interfaces: interfaces,
            initialInterface: selectedInterfaceName,
            changeInterface: { [weak self] in self?.setInterface($0) },
            initialColor: selectedOverlayColor,
            changeColor: { [weak self] in self?.setCustomColor($0) },
            applyColor: { [weak self] in self?.applySelectedColor() }
        )

        controls.updateMediaPath(blackout.mediaURL?.path ?? "")
        startOSC()

        GlobalInputMonitor.shared.start { [weak self] in
            guard let self, self.blackout.isActive, !self.blackout.ignoresInput else { return }
            self.restore()
        }
    }

    func applicationWillTerminate(_ notification: Notification) {
        blackout.restore()
        osc?.stop()
        GlobalInputMonitor.shared.stop()
    }

    private func installMainMenu() {
        let mainMenu = NSMenu()
        let appMenuItem = NSMenuItem()
        let appMenu = NSMenu(title: "BlackoutOSC")

        let quitItem = NSMenuItem(title: "Quit BlackoutOSC", action: #selector(quit), keyEquivalent: "q")
        quitItem.target = self
        appMenu.addItem(quitItem)

        appMenuItem.submenu = appMenu
        mainMenu.addItem(appMenuItem)
        NSApp.mainMenu = mainMenu
    }

    private func installStatusMenu() {
        statusItem = NSStatusBar.system.statusItem(withLength: NSStatusItem.variableLength)
        statusItem.button?.image = NSImage(systemSymbolName: "display", accessibilityDescription: "BlackoutOSC")

        let menu = NSMenu()
        menu.addItem(withTitle: "Settings", action: #selector(showControls), keyEquivalent: "")
        menu.addItem(.separator())
        menu.addItem(withTitle: "Overlay ON", action: #selector(blackOut), keyEquivalent: "")
        menu.addItem(withTitle: "Overlay OFF", action: #selector(restore), keyEquivalent: "")
        menu.addItem(.separator())

        let portItem = menu.addItem(withTitle: "OSC UDP port \(port)", action: nil, keyEquivalent: "")
        portItem.tag = 100
        portItem.isEnabled = false

        menu.addItem(.separator())
        menu.addItem(withTitle: "Quit", action: #selector(quit), keyEquivalent: "q")
        statusItem.menu = menu
    }

    private func startOSC() {
        osc?.stop()

        let server = OSCServer(port: port, bindAddress: selectedInterface?.address)
        server.onCommand = { [weak self, weak server] command in
            DispatchQueue.main.async {
                guard let self, self.osc === server else { return }
                self.handle(command)
            }
        }

        server.onStatus = { [weak self, weak server] status in
            DispatchQueue.main.async {
                guard let self, self.osc === server else { return }

                switch status {
                case .listening(let port, let interfaceLabel):
                    self.controls?.setOSCStatus("OSC: LISTENING — \(interfaceLabel):\(port)")
                case .stopped:
                    self.controls?.setOSCStatus("OSC: STOPPED")
                case .error(let message):
                    self.controls?.setOSCStatus("OSC: ERROR — \(message)", isError: true)
                }
            }
        }

        osc = server
        server.start()
    }

    private func setPort(_ newPort: UInt16) {
        guard newPort > 0, newPort != port else { return }

        UserDefaults.standard.set(Int(newPort), forKey: "oscPort")
        startOSC()
        statusItem.menu?.item(withTag: 100)?.title = "OSC UDP port \(newPort)"
        controls.setListeningPort(newPort)
    }

    private func setInterface(_ name: String) {
        guard name != selectedInterfaceName else { return }
        selectedInterfaceName = name
        startOSC()
        controls.setListeningInterface(name)
    }

    private func handle(_ command: OSCCommand) {
        switch command.address.lowercased() {
        case "/blackoutosc/start":
            if let path = command.firstString {
                _ = setMediaIfValid(URL(fileURLWithPath: path))
            }
            blackOut()

        case "/blackoutosc/stop":
            restore()

        case "/blackoutosc/black":
            blackDisplays()

        case "/blackoutosc/toggle":
            toggle()

        case "/blackoutosc/setmedia":
            guard let path = command.firstString,
                  setMediaIfValid(URL(fileURLWithPath: path)) else { return }
            if blackout.isActive { blackout.show() }

        case "/blackoutosc/videoloop":
            guard let value = command.firstString, value == "0" || value == "1" else { return }
            setLoopVideo(value == "1")

        case "/blackoutosc/videomute", "/blackoutosc/mute":
            guard let value = command.firstString, value == "0" || value == "1" else { return }
            setMuteVideo(value == "1")

        case "/blackoutosc/color":
            guard let value = command.firstString,
                  let color = colorFromHex(value) else {
                NSLog("BlackoutOSC: invalid color; expected #RRGGBB")
                return
            }
            setCustomColor(color)
            applySelectedColor()

        default:
            NSLog("Ignored OSC command: %@", command.address)
        }
    }

    @objc private func showControls() {
        controls.showWindow(nil)
        NSApp.activate(ignoringOtherApps: true)
        controls.window?.makeKeyAndOrderFront(nil)
    }

    @objc private func blackOut() {
        blackout.show()
        controls.setBlackoutActive(true)
        statusItem.button?.image = NSImage(systemSymbolName: "display.trianglebadge.exclamationmark", accessibilityDescription: "Blackout active")
    }

    private func blackDisplays() {
        blackout.showBlack()
        controls.setBlackoutActive(true)
        statusItem.button?.image = NSImage(systemSymbolName: "display.trianglebadge.exclamationmark", accessibilityDescription: "Blackout active")
    }

    @objc private func restore() {
        blackout.restore()
        controls.setBlackoutActive(false)
        statusItem.button?.image = NSImage(systemSymbolName: "display", accessibilityDescription: "Blackout inactive")
    }

    @objc private func toggle() {
        blackout.isActive ? restore() : blackOut()
    }

    @objc private func quit() {
        NSApp.terminate(nil)
    }

    private func clearMedia() {
        blackout.mediaURL = nil
        UserDefaults.standard.removeObject(forKey: mediaPathDefaultsKey)
        controls.updateMediaPath("")
        if blackout.isActive { blackout.show() }
    }

    private func setMedia(_ url: URL) {
        blackout.mediaURL = url
        UserDefaults.standard.set(url.path, forKey: mediaPathDefaultsKey)
        controls.updateMediaPath(url.path)
    }

    @discardableResult
    private func setMediaIfValid(_ url: URL) -> Bool {
        let type = UTType(filenameExtension: url.pathExtension)
        let isSupported = type?.conforms(to: .image) == true || type?.conforms(to: .movie) == true

        guard url.isFileURL,
              FileManager.default.isReadableFile(atPath: url.path),
              isSupported else {
            NSLog("BlackoutOSC: rejected unavailable or unsupported media: %@", url.path)
            return false
        }

        setMedia(url)
        return true
    }

    private func setLoopVideo(_ enabled: Bool) {
        loopVideo = enabled
        blackout.loopVideo = enabled
        controls.setLoopVideo(enabled)
        if blackout.isActive { blackout.show() }
    }

    private func setMuteVideo(_ enabled: Bool) {
        muteVideo = enabled
        blackout.muteVideo = enabled
        controls.setMuteVideo(enabled)
        if blackout.isActive { blackout.show() }
    }

    private func setCustomColor(_ color: NSColor) {
        selectedOverlayColor = color.usingColorSpace(.deviceRGB) ?? .black
        UserDefaults.standard.set(hexFromColor(selectedOverlayColor), forKey: "overlayColorHex")
        controls?.setSelectedColor(selectedOverlayColor)
    }

    private func applySelectedColor() {
        blackout.showColor(selectedOverlayColor)
        controls.setBlackoutActive(true)
        statusItem.button?.image = NSImage(
            systemSymbolName: "display.trianglebadge.exclamationmark",
            accessibilityDescription: "Color overlay active"
        )
    }

    private func chooseMedia() {
        let panel = NSOpenPanel()
        panel.allowedContentTypes = [.image, .movie]
        panel.allowsMultipleSelection = false
        panel.canChooseDirectories = false

        panel.begin { [weak self] response in
            guard response == .OK,
                  let url = panel.url,
                  let self,
                  self.setMediaIfValid(url) else { return }

            if self.blackout.isActive { self.blackout.show() }
        }
    }
}

private final class BlackoutController {
    private var panels: [NSPanel] = []
    private var blackOnly = false
    private var colorOnly = false
    private var activeColor = NSColor.black

    var mediaURL: URL?
    var loopVideo = false
    var muteVideo = false
    var ignoresInput = false
    var isActive: Bool { !panels.isEmpty }

    init() {
        NotificationCenter.default.addObserver(
            self,
            selector: #selector(screensChanged),
            name: NSApplication.didChangeScreenParametersNotification,
            object: nil
        )
    }

    deinit {
        NotificationCenter.default.removeObserver(self)
    }

    func show() {
        blackOnly = false
        colorOnly = false

        let image: NSImage?
        if let url = mediaURL,
           !isVideo(url),
           FileManager.default.isReadableFile(atPath: url.path) {
            image = NSImage(contentsOf: url)
        } else {
            image = nil
        }

        present(mediaURL: mediaURL, image: image)
    }

    func showBlack() {
        blackOnly = true
        colorOnly = false
        present(mediaURL: nil, image: nil)
    }

    func showColor(_ color: NSColor) {
        blackOnly = false
        colorOnly = true
        activeColor = color.usingColorSpace(.deviceRGB) ?? .black
        present(mediaURL: nil, image: nil, backgroundColor: activeColor)
    }

    private func present(mediaURL: URL?, image: NSImage?, backgroundColor: NSColor = .black) {
        restore()

        for screen in NSScreen.screens where screen.frame.width > 0 && screen.frame.height > 0 {
            let panel = NSPanel(
                contentRect: screen.frame,
                styleMask: [.borderless, .nonactivatingPanel],
                backing: .buffered,
                defer: false,
                screen: screen
            )

            panel.isOpaque = true
            panel.backgroundColor = backgroundColor
            panel.hasShadow = false
            panel.level = .screenSaver
            panel.collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary, .stationary, .ignoresCycle]
            panel.hidesOnDeactivate = false
            panel.ignoresMouseEvents = true

            let videoURL: URL?

            if let mediaURL, isVideo(mediaURL) {
                videoURL = mediaURL
            } else {
                videoURL = nil
            }

            panel.contentView = OverlayView(
                image: image,
                videoURL: videoURL,
                loopVideo: loopVideo,
                muted: muteVideo,
                backgroundColor: backgroundColor
            )
            panel.setFrame(screen.frame, display: true)
            panel.orderFrontRegardless()
            panels.append(panel)
        }
    }

    func restore() {
        panels.forEach {
            $0.orderOut(nil)
            $0.close()
        }
        panels.removeAll(keepingCapacity: true)
    }

    @objc private func screensChanged() {
        if isActive {
            if blackOnly { showBlack() }
            else if colorOnly { showColor(activeColor) }
            else { show() }
        }
    }

    private func isVideo(_ url: URL) -> Bool {
        UTType(filenameExtension: url.pathExtension)?.conforms(to: .movie) == true
    }
}

private final class OverlayView: NSView {
    private let image: NSImage?
    private let backgroundColor: NSColor
    private let player: AVPlayer?
    private let playerLayer: AVPlayerLayer?
    private var endObserver: NSObjectProtocol?

    init(image: NSImage?, videoURL: URL? = nil, loopVideo: Bool = false, muted: Bool = false, backgroundColor: NSColor = .black) {
        self.image = image
        self.backgroundColor = backgroundColor

        if let videoURL {
            let player = AVPlayer(url: videoURL)
            player.isMuted = muted
            self.player = player

            let layer = AVPlayerLayer(player: player)
            layer.videoGravity = .resizeAspect
            layer.backgroundColor = backgroundColor.cgColor
            self.playerLayer = layer

            super.init(frame: .zero)
            wantsLayer = true
            self.layer?.backgroundColor = backgroundColor.cgColor
            self.layer?.addSublayer(layer)

            if loopVideo, let item = player.currentItem {
                endObserver = NotificationCenter.default.addObserver(
                    forName: .AVPlayerItemDidPlayToEndTime,
                    object: item,
                    queue: .main
                ) { [weak player] _ in
                    guard let player else { return }
                    player.seek(to: .zero, toleranceBefore: .zero, toleranceAfter: .zero) { finished in
                        guard finished else { return }
                        player.play()
                    }
                }
            }

            player.play()
            return
        }

        self.player = nil
        self.playerLayer = nil
        super.init(frame: .zero)
        wantsLayer = true
        layer?.backgroundColor = backgroundColor.cgColor
    }

    deinit {
        if let endObserver {
            NotificationCenter.default.removeObserver(endObserver)
        }
        player?.pause()
    }

    required init?(coder: NSCoder) {
        fatalError("init(coder:) has not been implemented")
    }

    override func layout() {
        super.layout()
        playerLayer?.frame = bounds
    }

    override func draw(_ dirtyRect: NSRect) {
        backgroundColor.setFill()
        bounds.fill()

        guard let image else { return }
        let source = image.size
        guard source.width > 0, source.height > 0 else { return }

        let scale = min(bounds.width / source.width, bounds.height / source.height)
        let size = NSSize(width: source.width * scale, height: source.height * scale)
        let rect = NSRect(
            x: bounds.midX - size.width / 2,
            y: bounds.midY - size.height / 2,
            width: size.width,
            height: size.height
        )
        image.draw(in: rect, from: .zero, operation: .sourceOver, fraction: 1)
    }
}

