private struct NetworkInterface {
    let name: String
    let address: String
    let label: String

    static func available() -> [NetworkInterface] {
        var result: [NetworkInterface] = []
        var first: UnsafeMutablePointer<ifaddrs>?
        guard getifaddrs(&first) == 0 else { return result }
        defer { freeifaddrs(first) }

        var current = first
        while let entry = current?.pointee {
            defer { current = entry.ifa_next }
            guard let address = entry.ifa_addr,
                  address.pointee.sa_family == UInt8(AF_INET),
                  (entry.ifa_flags & UInt32(IFF_UP)) != 0,
                  (entry.ifa_flags & UInt32(IFF_RUNNING)) != 0 else { continue }

            let name = String(cString: entry.ifa_name)
            var ipv4 = address.withMemoryRebound(to: sockaddr_in.self, capacity: 1) {
                $0.pointee.sin_addr
            }
            var buffer = [CChar](repeating: 0, count: Int(INET_ADDRSTRLEN))
            guard inet_ntop(AF_INET, &ipv4, &buffer, socklen_t(INET_ADDRSTRLEN)) != nil else {
                continue
            }

            let ip = String(cString: buffer)
            guard !result.contains(where: { $0.name == name }) else { continue }
            result.append(NetworkInterface(name: name, address: ip, label: "\(name) — \(ip)"))
        }

        return result.sorted { $0.name.localizedStandardCompare($1.name) == .orderedAscending }
    }
}

private struct OSCCommand {
    let address: String
    let firstString: String?
}

private final class OSCServer {
    private let port: UInt16
    private let bindAddress: String?
    private let receiveQueue = DispatchQueue(
        label: "BlackoutOSC.UDP.receive",
        qos: .userInitiated
    )

    private let stateLock = NSLock()
    private var socket: Int32 = -1
    private var running = false
    private var generation = 0

    var onCommand: ((OSCCommand) -> Void)?
    var onStatus: ((OSCServerStatus) -> Void)?

    enum OSCServerStatus {
        case listening(UInt16, String)
        case stopped
        case error(String)
    }

    init(port: UInt16, bindAddress: String? = nil) {
        self.port = port
        self.bindAddress = bindAddress
    }

    func start() {
        stop()

        let fd = Darwin.socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP)
        guard fd >= 0 else {
            let message = "Could not create UDP socket: \(String(cString: strerror(errno)))"
            NSLog("BlackoutOSC: \(message)")
            onStatus?(.error(message))
            return
        }

        var reuse: Int32 = 1
        _ = setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &reuse,
                       socklen_t(MemoryLayout<Int32>.size))

        var address = sockaddr_in()
        address.sin_len = UInt8(MemoryLayout<sockaddr_in>.size)
        address.sin_family = sa_family_t(AF_INET)
        address.sin_port = port.bigEndian

        if let bindAddress {
            var selectedAddress = in_addr()
            let conversionResult = bindAddress.withCString {
                inet_pton(AF_INET, $0, &selectedAddress)
            }
            guard conversionResult == 1 else {
                let message = "Invalid IPv4 interface address: \(bindAddress)"
                Darwin.close(fd)
                onStatus?(.error(message))
                return
            }
            address.sin_addr = selectedAddress
        } else {
            address.sin_addr = in_addr(s_addr: INADDR_ANY)
        }

        let bindResult = withUnsafePointer(to: &address) {
            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) {
                Darwin.bind(fd, $0, socklen_t(MemoryLayout<sockaddr_in>.size))
            }
        }

        guard bindResult == 0 else {
            let message = "Could not bind UDP port \(port): \(String(cString: strerror(errno)))"
            NSLog("BlackoutOSC: \(message)")
            Darwin.close(fd)
            onStatus?(.error(message))
            return
        }

        stateLock.lock()
        generation += 1
        let token = generation
        socket = fd
        running = true
        stateLock.unlock()

        let interfaceLabel = bindAddress ?? "0.0.0.0"
        NSLog("BlackoutOSC: OSC listening on IPv4 UDP \(interfaceLabel):\(port)")
        onStatus?(.listening(port, interfaceLabel))

        receiveQueue.async { [weak self] in
            self?.receiveLoop(socket: fd, token: token)
        }
    }

    func stop() {
        stateLock.lock()
        generation += 1
        running = false
        let fd = socket
        socket = -1
        stateLock.unlock()

        if fd >= 0 {
            Darwin.shutdown(fd, SHUT_RDWR)
            Darwin.close(fd)
        }

        onStatus?(.stopped)
    }

    private func isRunning(token: Int) -> Bool {
        stateLock.lock()
        defer { stateLock.unlock() }
        return running && generation == token
    }

    private func receiveLoop(socket: Int32, token: Int) {
        var buffer = [UInt8](repeating: 0, count: 65_535)

        while isRunning(token: token) {
            var sender = sockaddr_storage()
            var senderLength = socklen_t(MemoryLayout<sockaddr_storage>.size)

            let count = buffer.withUnsafeMutableBytes { bytes in
                withUnsafeMutablePointer(to: &sender) { senderPtr in
                    senderPtr.withMemoryRebound(to: sockaddr.self, capacity: 1) {
                        Darwin.recvfrom(socket, bytes.baseAddress, bytes.count, 0, $0, &senderLength)
                    }
                }
            }

            if count > 0 {
                let data = Data(buffer[0..<Int(count)])
                NSLog("BlackoutOSC: Received UDP packet (%d bytes)", Int(count))
                let commands = Self.parseMessages(data)

                if commands.isEmpty {
                    NSLog("BlackoutOSC: Packet received but could not parse as OSC")
                }

                for command in commands {
                    NSLog("BlackoutOSC: OSC address = %@", command.address)
                    if let argument = command.firstString {
                        NSLog("BlackoutOSC: OSC string argument = %@", argument)
                    }
                    onCommand?(command)
                }
            } else if count < 0 {
                let error = errno
                if error != EBADF && error != EINTR && error != ECONNRESET && isRunning(token: token) {
                    NSLog("BlackoutOSC: recvfrom error: %s", strerror(error))
                }
            }
        }

        NSLog("BlackoutOSC: UDP receive loop stopped")
    }

    private static func parseMessages(_ data: Data) -> [OSCCommand] {
        guard !data.isEmpty else { return [] }
        if string(at: 0, in: data) == "#bundle" { return parseBundle(data) }
        if let message = parseMessage(data) { return [message] }
        return []
    }

    private static func parseBundle(_ data: Data) -> [OSCCommand] {
        guard data.count >= 16 else { return [] }
        var offset = 16
        var commands: [OSCCommand] = []

        while offset + 4 <= data.count {
            let length = data[offset..<(offset + 4)].reduce(UInt32(0)) {
                ($0 << 8) | UInt32($1)
            }
            offset += 4
            let end = offset + Int(length)
            guard length > 0, end <= data.count else { break }
            commands += parseMessages(data.subdata(in: offset..<end))
            offset = end
        }
        return commands
    }

    private static func parseMessage(_ data: Data) -> OSCCommand? {
        guard let address = string(at: 0, in: data), address.hasPrefix("/") else { return nil }
        let typeOffset = paddedLength(at: 0, in: data)
        guard typeOffset < data.count else {
            return OSCCommand(address: address, firstString: nil)
        }
        guard let tags = string(at: typeOffset, in: data) else {
            return OSCCommand(address: address, firstString: nil)
        }
        if tags.hasPrefix(",s") {
            let argumentOffset = typeOffset + paddedLength(at: typeOffset, in: data)
            return OSCCommand(address: address, firstString: string(at: argumentOffset, in: data))
        }
        return OSCCommand(address: address, firstString: nil)
    }

    private static func string(at offset: Int, in data: Data) -> String? {
        guard offset < data.count else { return nil }
        let bytes = data[offset...]
        guard let end = bytes.firstIndex(of: 0) else { return nil }
        return String(data: data[offset..<end], encoding: .utf8)
    }

    private static func paddedLength(at offset: Int, in data: Data) -> Int {
        guard offset < data.count else { return 0 }
        let count = data[offset...].prefix { $0 != 0 }.count + 1
        return ((count + 3) / 4) * 4
    }
}

private final class GlobalInputMonitor {
    static let shared = GlobalInputMonitor()
    private var monitor: Any?

    func start(onInput: @escaping () -> Void) {
        stop()
        monitor = NSEvent.addGlobalMonitorForEvents(
            matching: [.keyDown, .leftMouseDown, .rightMouseDown, .otherMouseDown]
        ) { _ in
            onInput()
        }
    }

    func stop() {
        if let monitor { NSEvent.removeMonitor(monitor) }
        monitor = nil
    }
}

